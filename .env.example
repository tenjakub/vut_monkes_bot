# Token bota z https://discord.com/developers/applications -> tvoje aplikace -> Bot -> Reset Token
# Lokálně sem patří token VÝVOJOVÉHO bota, produkční token je jen v Portaineru na serveru.
DISCORD_TOKEN=

# Volitelné: ID vašeho serveru (pravý klik na server -> Kopírovat ID, potřeba zapnutý režim vývojáře).
# Když je vyplněné, slash commandy se objeví hned; jinak se registrují globálně (může trvat až hodinu).
GUILD_IDS=

# Volitelné: kde je databáze (SQLite). Výchozí je data/bot.db ve složce projektu.
# DB_PATH=data/bot.db

# --- jen pro Docker (docker-compose.yml) ---

# Verze image: "latest" = vždy nejnovější z main. Pro návrat ke starší verzi dej např. sha-fbc4bee
# (seznam verzí: https://github.com/tenjakub/vut_monkes_bot/pkgs/container/vut_monkes_bot).
BOT_TAG=latest

# Jak často (v sekundách) se má kontrolovat nová verze bota.
WATCHTOWER_POLL_INTERVAL=300
