# Token bota z https://discord.com/developers/applications -> tvoje aplikace -> Bot -> Reset Token
DISCORD_TOKEN=

# Volitelné: ID vašeho serveru (pravý klik na server -> Kopírovat ID, potřeba zapnutý režim vývojáře).
# Když je vyplněné, slash commandy se objeví hned; jinak se registrují globálně (může trvat až hodinu).
GUILD_IDS=
